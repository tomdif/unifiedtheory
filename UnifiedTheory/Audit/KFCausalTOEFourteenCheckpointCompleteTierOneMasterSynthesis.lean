    (ε : ℝ) (hε : 0 < ε) (h : ℝ) (hh : h ≠ 0)
    (hb : |h| ≤ Real.pi * ε / 3) (m_mass g k : ℝ)
    (a b c : ℝ) (ha : 0 < a) (hb_pos : 0 < b) (hc : 0 < c)
