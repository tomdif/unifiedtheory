/- The closed operator generated by the planar polynomial Gaussian
oscillator has the full weighted circular-coefficient domain. -/
import UnifiedTheory.Audit.KFCausalCircularOscillatorBasis
import UnifiedTheory.Audit.KFCausalCompleteEigenbasisClosure

set_option autoImplicit false
set_option relaxedAutoImplicit false
-- The range transport uses dependent polynomial-state coercions.
set_option maxHeartbeats 1600000
set_option maxRecDepth 4096

namespace UnifiedTheory.Audit.KFCausalCircularOscillatorDomain
noncomputable section
open KFCausalEuclideanProductCoordinates (BlockHilbert)
open KFCausalCircularOscillatorBasis
open KFCausalCircularOscillatorTriangular (energy)
open KFCausalCircularOscillatorPolynomial (oscillator)
open KFCausalPlanePolynomialGaussian (Poly state)
open KFCausalScaledCircularPolynomials (width_positive)

variable (c : ℝ) (hc : c ≠ 0) (b : ℝ) (hb : 0 < b)
local notation "J" => state (b*c^2) b (width_positive c b hc hb) hb
local notation "B" => KFCausalCircularChargeBasis.basis c hc b hb

def core : BlockHilbert 2 →ₗ.[ℂ] BlockHilbert 2 where
  domain := Domain c hc b hb
  toFun := (Domain c hc b hb).subtype.comp (operator c hc b hb)

theorem core_graph (P : Poly) : (J P, J (oscillator c b P)) ∈ (core c hc b hb).graph := by
  have hg := (core c hc b hb).mem_graph (polynomialEquiv c hc b hb P)
  change (_, (operator c hc b hb (polynomialEquiv c hc b hb P)).val) ∈ _ at hg
  rw [operator_apply] at hg
  exact hg

theorem core_symmetric : (core c hc b hb).IsFormalAdjoint (core c hc b hb) :=
  operator_symmetric c hc b hb

theorem basis_graph (n : ℕ) :
    (B n, (energy c b n:ℂ) • B n) ∈ (core c hc b hb).graph := by
  have hg := core_graph c hc b hb (normalizedPolynomial c hc b hb n)
  rwa [normalized_state, basis_oscillator] at hg

theorem core_closable : (core c hc b hb).IsClosable :=
  KFCausalCompleteEigenbasisClosure.closable (core c hc b hb) (B) (energy c b)
    (core_symmetric c hc b hb) (basis_graph c hc b hb)

def closedOperator : BlockHilbert 2 →ₗ.[ℂ] BlockHilbert 2 := (core c hc b hb).closure

theorem graph_iff (f g : BlockHilbert 2) :
    (f, g) ∈ (closedOperator c hc b hb).graph ↔
      ∀ n, inner ℂ (B n) g = (energy c b n:ℂ)*inner ℂ (B n) f :=
  KFCausalCompleteEigenbasisClosure.graph_iff (core c hc b hb) (B) (energy c b)
    (core_symmetric c hc b hb) (basis_graph c hc b hb) f g

theorem domain_iff_summable (f : BlockHilbert 2) :
    f ∈ (closedOperator c hc b hb).domain ↔
      Summable (fun n => (energy c b n)^2*‖inner ℂ (B n) f‖^2) :=
  KFCausalCompleteEigenbasisClosure.domain_iff_summable (core c hc b hb) (B) (energy c b)
    (core_symmetric c hc b hb) (basis_graph c hc b hb) f

#print axioms core_graph
#print axioms core_closable
#print axioms graph_iff
#print axioms domain_iff_summable
end
end UnifiedTheory.Audit.KFCausalCircularOscillatorDomain
