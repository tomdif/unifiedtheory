/- Exact transport invariance of the positive longitudinal exponential, including
its maximal graph and domain. This transport is generated by the longitudinal
momentum; it is not the full, charge-averaged Hamiltonian evolution. -/
import UnifiedTheory.Audit.KFCausalClockFloorExponential
import UnifiedTheory.Audit.KFCausalLpPhaseTranslation

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 800000

namespace UnifiedTheory.Audit.KFCausalClockFloorSpectralTransport
noncomputable section
open MeasureTheory
open UnifiedTheory.Audit.KFCausalConfigurationTestSpace (Hilbert)
open UnifiedTheory.Audit.KFCausalClockFloorUnitaryTransport
open UnifiedTheory.Audit.KFCausalClockFloorFourierCoordinates
open UnifiedTheory.Audit.KFCausalClockFloorFourierMultiplier
open UnifiedTheory.Audit.KFCausalClockFloorExponential
open UnifiedTheory.Audit.KFCausalLpPhaseTranslation (modulation modulation_coe phase)

theorem exponential_graph_transport (ε : ℝ) (hε : 0 < ε) (h a t : ℝ)
    (f g : Hilbert) (hfg : (f,g) ∈ (longitudinalExponential ε hε h a).graph) :
    (transport ε hε t f,transport ε hε t g) ∈
      (longitudinalExponential ε hε h a).graph := by
  rw [longitudinal_exponential_graph] at hfg ⊢
  filter_upwards [hfg,coupledFourier_transport_coe ε hε t f,
    coupledFourier_transport_coe ε hε t g] with k hk hf hg
  rw [hg,hf,hk]
  ring

theorem exponential_graph_transport_iff (ε : ℝ) (hε : 0 < ε) (h a t : ℝ)
    (f g : Hilbert) :
    (transport ε hε t f,transport ε hε t g) ∈
      (longitudinalExponential ε hε h a).graph ↔
    (f,g) ∈ (longitudinalExponential ε hε h a).graph := by
  constructor
  · intro hfg
    simpa only [transport_reverse] using
      exponential_graph_transport ε hε h a (-t) _ _ hfg
  · exact exponential_graph_transport ε hε h a t f g

theorem exponential_domain_transport_iff (ε : ℝ) (hε : 0 < ε) (h a t : ℝ)
    (f : Hilbert) :
    transport ε hε t f ∈ (longitudinalExponential ε hε h a).domain ↔
      f ∈ (longitudinalExponential ε hε h a).domain := by
  have forward (u : ℝ) (v : Hilbert)
      (hv : v ∈ (longitudinalExponential ε hε h a).domain) :
      transport ε hε u v ∈ (longitudinalExponential ε hε h a).domain :=
    LinearPMap.mem_domain_of_mem_graph (exponential_graph_transport ε hε h a u v _
      ((longitudinalExponential ε hε h a).mem_graph ⟨v,hv⟩))
  constructor
  · intro hf
    simpa only [transport_reverse] using forward (-t) _ hf
  · exact forward t f

theorem exponential_action_transport (ε : ℝ) (hε : 0 < ε) (h a t : ℝ)
    (f : (longitudinalExponential ε hε h a).domain) :
    longitudinalExponential ε hε h a
      ⟨transport ε hε t f,(exponential_domain_transport_iff ε hε h a t f).mpr f.property⟩ =
      transport ε hε t (longitudinalExponential ε hε h a f) := by
  exact (longitudinalExponential ε hε h a).mem_graph_snd_inj'
    ((longitudinalExponential ε hε h a).mem_graph _)
    (exponential_graph_transport ε hε h a t _ _
      ((longitudinalExponential ε hε h a).mem_graph f)) rfl

theorem exponential_energy_transport (ε : ℝ) (hε : 0 < ε) (h a t : ℝ)
    (f : (longitudinalExponential ε hε h a).domain) :
    ‖longitudinalExponential ε hε h a
      ⟨transport ε hε t f,(exponential_domain_transport_iff ε hε h a t f).mpr f.property⟩‖ =
      ‖longitudinalExponential ε hε h a f‖ := by
  rw [exponential_action_transport,LinearIsometryEquiv.norm_map]

/-- At transport time h*v, the phase is v times the actual longitudinal
momentum symbol. No nonzero-h assumption or canonical-clock identification. -/
theorem scaled_transport_fourier (ε : ℝ) (hε : 0 < ε) (h v : ℝ) (f : Hilbert) :
    coupledFourier ε hε (transport ε hε (h*v) f) =
      modulation volume (fun k => v*symbol h k)
        (measurable_const.mul (symbol_measurable h)) (coupledFourier ε hε f) := by
  apply Lp.ext
  filter_upwards [coupledFourier_transport_coe ε hε (h*v) f,
    modulation_coe volume (fun k => v*symbol h k)
      (measurable_const.mul (symbol_measurable h)) (coupledFourier ε hε f)] with k ht hm
  rw [ht,hm]
  congr 2
  unfold symbol
  push_cast
  ring

#print axioms exponential_graph_transport
#print axioms exponential_graph_transport_iff
#print axioms exponential_domain_transport_iff
#print axioms exponential_action_transport
#print axioms exponential_energy_transport
#print axioms scaled_transport_fourier

end
end UnifiedTheory.Audit.KFCausalClockFloorSpectralTransport
