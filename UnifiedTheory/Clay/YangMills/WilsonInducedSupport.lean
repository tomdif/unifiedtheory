/- Actual finite supports generated by eliminating an independent Wilson link block.
Every support is derived from the four oriented plaquette links. The resulting
star interactions are not assumed to retain the original plaquette form. -/
import UnifiedTheory.Clay.YangMills.WilsonPhysicalStencilLocality
import UnifiedTheory.Clay.YangMills.WilsonBlockIntegration
import Mathlib.Logic.Function.DependsOn

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace UnifiedTheory.Clay.YangMills.WilsonInducedSupport
noncomputable section
open RegulatedGauge PeriodicLattice4 WilsonIndependentBlocks WilsonInfluenceGeometry
open SingleLinkWilsonOscillation WilsonUniformVariance WilsonMomentBounds

variable (n : ℕ) [NeZero n]
local instance edgeDecidableEq : DecidableEq (Edge (Vertex n)) := Classical.decEq _
local instance linkDecidableEq : DecidableEq (Link n) := Classical.decEq _
local instance plaquetteDecidableEq : DecidableEq (PlaquetteIndex n) := Classical.decEq _

/-- The four actual edge coordinates used by one oriented Wilson plaquette. -/
def plaquetteEdges (p : PlaquetteIndex n) : Finset (Edge (Vertex n)) :=
  (incidentLinks n p).image (fun a => selectedLink n a.1 a.2)

theorem mem_plaquetteEdges (p : PlaquetteIndex n) (e : Edge (Vertex n)) :
    e ∈ plaquetteEdges n p ↔ p ∈ affected n (edgeCoord n e).1 (edgeCoord n e).2 := by
  constructor
  · intro h
    obtain ⟨a, ha, he⟩ := Finset.mem_image.mp h
    subst e
    exact (affected_iff_incident n p a).mpr ((mem_incidentLinks n p a).mp ha)
  · intro h
    exact Finset.mem_image.mpr ⟨edgeCoord n e,
      (mem_incidentLinks n p _).mpr ((affected_iff_incident n p _).mp h),
      selected_edgeCoord n e⟩

omit [NeZero n] in
theorem plaquetteEdges_card (p : PlaquetteIndex n) : (plaquetteEdges n p).card ≤ 4 :=
  (Finset.card_image_le).trans (incidentLinks_card_le n p)

/-- The induced star includes every edge of every plaquette touching the removed edge. -/
def star (e : Edge (Vertex n)) : Finset (Edge (Vertex n)) :=
  (affected n (edgeCoord n e).1 (edgeCoord n e).2).biUnion (plaquetteEdges n)

theorem mem_star (e d : Edge (Vertex n)) : d ∈ star n e ↔
    ∃ p : PlaquetteIndex n, e ∈ plaquetteEdges n p ∧ d ∈ plaquetteEdges n p := by
  simp only [star, Finset.mem_biUnion, mem_plaquetteEdges]

theorem star_symm (e d : Edge (Vertex n)) : d ∈ star n e ↔ e ∈ star n d := by
  simp only [mem_star]
  exact exists_congr (fun _ => and_comm)

theorem plaquetteEdges_subset_star (p : PlaquetteIndex n) (e : Edge (Vertex n))
    (he : e ∈ plaquetteEdges n p) : plaquetteEdges n p ⊆ star n e :=
  fun _ hd => (mem_star n _ _).mpr ⟨p, he, hd⟩

theorem star_card (e : Edge (Vertex n)) : (star n e).card ≤ 24 := by
  calc
    _ ≤ ∑ p ∈ affected n (edgeCoord n e).1 (edgeCoord n e).2,
        (plaquetteEdges n p).card := Finset.card_biUnion_le
    _ ≤ ∑ _p ∈ affected n (edgeCoord n e).1 (edgeCoord n e).2, 4 :=
      Finset.sum_le_sum (fun p _ => plaquetteEdges_card n p)
    _ ≤ 24 := by
      simp only [Finset.sum_const, smul_eq_mul]
      have h := affected_card n (edgeCoord n e).1 (edgeCoord n e).2
      omega

/-- Deleted coordinates are removed from the generated support, not treated as retained data. -/
def retainedStar (S : Finset (Edge (Vertex n))) (e : Edge (Vertex n)) :
    Finset (Edge (Vertex n)) := star n e \ S

omit [NeZero n] in
theorem retainedStar_eq_union (S : Finset (Edge (Vertex n))) (e : Edge (Vertex n)) :
    retainedStar n S e =
      (affected n (edgeCoord n e).1 (edgeCoord n e).2).biUnion
        (fun p => plaquetteEdges n p \ S) := by
  ext d
  simp only [retainedStar, star, Finset.mem_sdiff, Finset.mem_biUnion]
  aesop

/-- At most eighteen genuine retained coordinates occur in one removed-link factor. -/
theorem retainedStar_card (S : Finset (Edge (Vertex n))) (e : Edge (Vertex n)) (he : e ∈ S) :
    (retainedStar n S e).card ≤ 18 := by
  rw [retainedStar_eq_union]
  calc
    _ ≤ ∑ p ∈ affected n (edgeCoord n e).1 (edgeCoord n e).2,
        (plaquetteEdges n p \ S).card := Finset.card_biUnion_le
    _ ≤ ∑ _p ∈ affected n (edgeCoord n e).1 (edgeCoord n e).2, 3 := by
      apply Finset.sum_le_sum
      intro p hp
      have hm := (mem_plaquetteEdges n p e).mpr hp
      have hs : plaquetteEdges n p \ S ⊆ (plaquetteEdges n p).erase e := by
        intro d hd
        obtain ⟨hdp, hdS⟩ := Finset.mem_sdiff.mp hd
        exact Finset.mem_erase.mpr ⟨fun h => hdS (h ▸ he), hdp⟩
      have hcard := Finset.card_erase_add_one hm
      have hb := plaquetteEdges_card n p
      exact (Finset.card_le_card hs).trans (by omega)
    _ ≤ 18 := by
      simp only [Finset.sum_const, smul_eq_mul]
      have h := affected_card n (edgeCoord n e).1 (edgeCoord n e).2
      omega

/-- Geometric Wilson independence implies the exact one-coordinate-per-factor property. -/
theorem selected_unique (S : Finset (Edge (Vertex n)))
    (hS : Independent n (S.image (edgeCoord n))) (p : PlaquetteIndex n)
    (e d : Edge (Vertex n)) (he : e ∈ S) (hd : d ∈ S)
    (hep : e ∈ plaquetteEdges n p) (hdp : d ∈ plaquetteEdges n p) : e = d := by
  have h := independent_unique n _ hS (edgeCoord n e) (edgeCoord n d)
    (Finset.mem_image.mpr ⟨e, he, rfl⟩) (Finset.mem_image.mpr ⟨d, hd, rfl⟩) p
    ((mem_plaquetteEdges n p e).mp hep) ((mem_plaquetteEdges n p d).mp hdp)
  rw [← selected_edgeCoord n e, ← selected_edgeCoord n d, h]

theorem plaquette_inter_card (S : Finset (Edge (Vertex n)))
    (hS : Independent n (S.image (edgeCoord n))) (p : PlaquetteIndex n) :
    (plaquetteEdges n p ∩ S).card ≤ 1 := by
  apply Finset.card_le_one.mpr
  intro e he d hd
  exact selected_unique n S hS p e d (Finset.mem_inter.mp he).2
    (Finset.mem_inter.mp hd).2 (Finset.mem_inter.mp he).1 (Finset.mem_inter.mp hd).1

/-- The geometric support available to a retained response of one plaquette source. -/
def responseSupport (S : Finset (Edge (Vertex n))) (p : PlaquetteIndex n) :
    Finset (Edge (Vertex n)) :=
  (plaquetteEdges n p ∪ (plaquetteEdges n p ∩ S).biUnion (star n)) \ S

theorem responseSupport_subset_star (S : Finset (Edge (Vertex n)))
    (hS : Independent n (S.image (edgeCoord n))) (p : PlaquetteIndex n)
    (e : Edge (Vertex n)) (he : e ∈ S) (hep : e ∈ plaquetteEdges n p) :
    responseSupport n S p ⊆ retainedStar n S e := by
  intro d hd
  obtain ⟨hd, hdS⟩ := Finset.mem_sdiff.mp hd
  refine Finset.mem_sdiff.mpr ⟨?_, hdS⟩
  rcases Finset.mem_union.mp hd with hd | hd
  · exact plaquetteEdges_subset_star n p e hep hd
  · obtain ⟨j, hj, hd⟩ := Finset.mem_biUnion.mp hd
    have hj' := selected_unique n S hS p j e (Finset.mem_inter.mp hj).2 he
      (Finset.mem_inter.mp hj).1 hep
    simpa only [hj'] using hd

theorem responseSupport_card (S : Finset (Edge (Vertex n)))
    (hS : Independent n (S.image (edgeCoord n))) (p : PlaquetteIndex n) :
    (responseSupport n S p).card ≤ 18 := by
  by_cases h : ∃ e ∈ S, e ∈ plaquetteEdges n p
  · obtain ⟨e, he, hep⟩ := h
    exact (Finset.card_le_card (responseSupport_subset_star n S hS p e he hep)).trans
      (retainedStar_card n S e he)
  · have hi : plaquetteEdges n p ∩ S = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro e he
      exact h ⟨e, (Finset.mem_inter.mp he).2, (Finset.mem_inter.mp he).1⟩
    simp only [responseSupport, hi, Finset.biUnion_empty, Finset.union_empty]
    exact (Finset.card_le_card Finset.sdiff_subset).trans ((plaquetteEdges_card n p).trans
      (by norm_num))

/-- Every generated edge lies within one coordinate step, modulo the actual period. -/
theorem star_coordinate (e d : Edge (Vertex n)) (hd : d ∈ star n e) (ν : Fin 4) :
    ∃ t : ℤ, -1 ≤ t ∧ t ≤ 1 ∧
      (edgeCoord n d).1 ν - (edgeCoord n e).1 ν = (t : ZMod n) := by
  obtain ⟨p, hep, hdp⟩ := (mem_star n e d).mp hd
  obtain ⟨te, he0, he1, he⟩ := WilsonPhysicalStencilLocality.affected_coordinate n
    (edgeCoord n e).1 (edgeCoord n e).2 ν p ((mem_plaquetteEdges n p e).mp hep)
  obtain ⟨td, hd0, hd1, hh⟩ := WilsonPhysicalStencilLocality.affected_coordinate n
    (edgeCoord n d).1 (edgeCoord n d).2 ν p ((mem_plaquetteEdges n p d).mp hdp)
  refine ⟨td - te, by omega, by omega, ?_⟩
  have hde : (edgeCoord n d).1 ν - p.1 ν = (td : ZMod n) := by rw [hh]; ring
  have hee : (edgeCoord n e).1 ν - p.1 ν = (te : ZMod n) := by rw [he]; ring
  calc
    _ = ((edgeCoord n d).1 ν - p.1 ν) - ((edgeCoord n e).1 ν - p.1 ν) := by ring
    _ = _ := by rw [hde, hee, Int.cast_sub]

/-- A concrete coordinate separation excludes overlap of two generated stars. -/
theorem disjoint_stars_of_coordinate_separation (e d : Edge (Vertex n)) (ν : Fin 4)
    (hsep : ∀ t : ℤ, -2 ≤ t → t ≤ 2 →
      (edgeCoord n e).1 ν - (edgeCoord n d).1 ν ≠ (t : ZMod n)) :
    Disjoint (star n e) (star n d) := by
  apply Finset.disjoint_left.mpr
  intro z hze hzd
  obtain ⟨te, he0, he1, he⟩ := star_coordinate n e z hze ν
  obtain ⟨td, hd0, hd1, hd⟩ := star_coordinate n d z hzd ν
  apply hsep (td - te) (by omega) (by omega)
  calc
    _ = ((edgeCoord n z).1 ν - (edgeCoord n d).1 ν) -
        ((edgeCoord n z).1 ν - (edgeCoord n e).1 ν) := by ring
    _ = _ := by rw [hd, he, Int.cast_sub]

/-- A concrete sufficient separation for independence after the first elimination. -/
def SeparatedStars (T : Finset (Edge (Vertex n))) : Prop :=
  ∀ e ∈ T, ∀ d ∈ T, e ≠ d → Disjoint (star n e) (star n d)

theorem separatedStars_of_coordinates (T : Finset (Edge (Vertex n)))
    (h : ∀ e ∈ T, ∀ d ∈ T, e ≠ d → ∃ ν : Fin 4,
      ∀ t : ℤ, -2 ≤ t → t ≤ 2 →
        (edgeCoord n e).1 ν - (edgeCoord n d).1 ν ≠ (t : ZMod n)) :
    SeparatedStars n T := by
  intro e he d hd hed
  obtain ⟨ν, hν⟩ := h e he d hd hed
  exact disjoint_stars_of_coordinate_separation n e d ν hν

theorem separated_plaquette_unique (T : Finset (Edge (Vertex n)))
    (hT : SeparatedStars n T) (p : PlaquetteIndex n) (e d : Edge (Vertex n))
    (he : e ∈ T) (hd : d ∈ T) (hep : e ∈ plaquetteEdges n p)
    (hdp : d ∈ plaquetteEdges n p) : e = d := by
  by_contra h
  exact Finset.disjoint_left.mp (hT e he d hd h)
    ((mem_star n e e).mpr ⟨p, hep, hep⟩) ((mem_star n d e).mpr ⟨p, hdp, hep⟩)

theorem separated_star_unique (T : Finset (Edge (Vertex n))) (hT : SeparatedStars n T)
    (j e d : Edge (Vertex n)) (he : e ∈ T) (hd : d ∈ T)
    (hej : e ∈ star n j) (hdj : d ∈ star n j) : e = d := by
  by_contra h
  exact Finset.disjoint_left.mp (hT e he d hd h)
    ((star_symm n j e).mp hej) ((star_symm n j d).mp hdj)

/-- Supports of all residual original factors and all generated star factors. -/
def inducedSupport (S : Finset (Edge (Vertex n))) :
    PlaquetteIndex n ⊕ {e : Edge (Vertex n) // e ∈ S} → Finset (Edge (Vertex n)) :=
  Sum.elim (fun p => plaquetteEdges n p \ S) (fun e => retainedStar n S e.val)

theorem inducedSupport_card (S : Finset (Edge (Vertex n)))
    (j : PlaquetteIndex n ⊕ {e : Edge (Vertex n) // e ∈ S}) :
    (inducedSupport n S j).card ≤ 18 := by
  rcases j with p | e
  · exact (Finset.card_le_card Finset.sdiff_subset).trans ((plaquetteEdges_card n p).trans
      (by norm_num))
  · exact retainedStar_card n S e.val e.property

omit [NeZero n] in
theorem inducedSupport_disjoint_removed (S : Finset (Edge (Vertex n)))
    (j : PlaquetteIndex n ⊕ {e : Edge (Vertex n) // e ∈ S}) :
    Disjoint (inducedSupport n S j) S := by
  rcases j with p | e <;> exact Finset.sdiff_disjoint

/-- Star separation supplies the actual one-coordinate-per-induced-factor condition. -/
theorem next_selected_unique (S T : Finset (Edge (Vertex n))) (hT : SeparatedStars n T)
    (j : PlaquetteIndex n ⊕ {e : Edge (Vertex n) // e ∈ S})
    (e d : Edge (Vertex n)) (he : e ∈ T) (hd : d ∈ T)
    (hej : e ∈ inducedSupport n S j) (hdj : d ∈ inducedSupport n S j) : e = d := by
  rcases j with p | j
  · exact separated_plaquette_unique n T hT p e d he hd
      (Finset.mem_sdiff.mp hej).1 (Finset.mem_sdiff.mp hdj).1
  · exact separated_star_unique n T hT j.val e d he hd
      (Finset.mem_sdiff.mp hej).1 (Finset.mem_sdiff.mp hdj).1

variable (G : Type*) [Group G]

/-- Actual holonomy supplies the original local support, without a locality premise. -/
theorem plaquetteTerm_dependsOn (χ : G → ℂ) (c : ℝ) (p : PlaquetteIndex n) :
    DependsOn (fun U => plaquetteTerm n G χ c U p) (plaquetteEdges n p : Set _) := by
  intro U V hUV
  have hp := plaquette_congr n G p U V (by
    intro e he
    exact hUV e ((mem_plaquetteEdges n p e).mpr
      ((affected_iff_incident n p (edgeCoord n e)).mpr he)))
  dsimp only
  unfold plaquetteTerm loopObservable wilson
  rw [hp]

theorem term_update_unchanged (χ : G → ℂ) (c : ℝ) (p : PlaquetteIndex n)
    (e : Edge (Vertex n)) (he : e ∉ plaquetteEdges n p)
    (U : Configuration (Vertex n) G) (q : G) :
    plaquetteTerm n G χ c (Function.update U e q) p = plaquetteTerm n G χ c U p := by
  apply plaquetteTerm_dependsOn n G χ c p
  intro d hd
  have hde : d ≠ e := fun h => he (h ▸ hd)
  exact Function.update_of_ne hde q U

/-- Exact cancellation of all unaffected terms localizes the full action increment. -/
theorem action_increment_sum (χ : G → ℂ) (β c : ℝ)
    (U : Configuration (Vertex n) G) (e : Edge (Vertex n)) (q : G) :
    WilsonBlockIntegration.action n G χ β c (Function.update U e q) -
      WilsonBlockIntegration.action n G χ β c U =
      β * ∑ p ∈ affected n (edgeCoord n e).1 (edgeCoord n e).2,
        (plaquetteTerm n G χ c (Function.update U e q) p - plaquetteTerm n G χ c U p) := by
  change β * (∑ p, plaquetteTerm n G χ c (Function.update U e q) p) -
    β * (∑ p, plaquetteTerm n G χ c U p) = _
  rw [← mul_sub, ← Finset.sum_sub_distrib]
  congr 1
  symm
  apply Finset.sum_subset (Finset.subset_univ _)
  intro p _ hp
  rw [term_update_unchanged n G χ c p e
    (fun h => hp ((mem_plaquetteEdges n p e).mp h)) U q, sub_self]

/-- The literal full-action single-site increment depends only on its actual star. -/
theorem action_increment_dependsOn (χ : G → ℂ) (β c : ℝ) (e : Edge (Vertex n)) (q : G) :
    DependsOn (fun U => WilsonBlockIntegration.action n G χ β c (Function.update U e q) -
      WilsonBlockIntegration.action n G χ β c U) (star n e : Set _) := by
  intro U V hUV
  dsimp only
  rw [action_increment_sum, action_increment_sum]
  congr 1
  apply Finset.sum_congr rfl
  intro p hp
  have hs := plaquetteEdges_subset_star n p e ((mem_plaquetteEdges n p e).mpr hp)
  have hbase : plaquetteTerm n G χ c U p = plaquetteTerm n G χ c V p :=
    plaquetteTerm_dependsOn n G χ c p (fun d hd => hUV d (hs hd))
  have hup : plaquetteTerm n G χ c (Function.update U e q) p =
      plaquetteTerm n G χ c (Function.update V e q) p := by
    apply plaquetteTerm_dependsOn n G χ c p
    intro d hd
    by_cases hde : d = e
    · subst d
      exact (Function.update_self e q U).trans (Function.update_self e q V).symm
    · simp only [Function.update_of_ne hde, hUV d (hs hd)]
  rw [hbase, hup]

/-- The actual original source increment has the same star support as the action increment. -/
theorem source_increment_dependsOn (χ : G → ℂ) (c : ℝ) (f : PlaquetteIndex n → ℝ)
    (e : Edge (Vertex n)) (q : G) :
    DependsOn (fun U => WilsonBlockIntegration.source n G χ c f (Function.update U e q) -
      WilsonBlockIntegration.source n G χ c f U) (star n e : Set _) := by
  intro U V hUV
  dsimp only
  simp only [WilsonBlockIntegration.source, ← Finset.sum_sub_distrib, ← mul_sub]
  apply Finset.sum_congr rfl
  intro p _
  by_cases hp : p ∈ affected n (edgeCoord n e).1 (edgeCoord n e).2
  · have hs := plaquetteEdges_subset_star n p e ((mem_plaquetteEdges n p e).mpr hp)
    have hb : plaquetteTerm n G χ c U p = plaquetteTerm n G χ c V p :=
      plaquetteTerm_dependsOn n G χ c p (fun d hd => hUV d (hs hd))
    have hu : plaquetteTerm n G χ c (Function.update U e q) p =
        plaquetteTerm n G χ c (Function.update V e q) p := by
      apply plaquetteTerm_dependsOn n G χ c p
      intro d hd
      by_cases hde : d = e
      · subst d
        exact (Function.update_self e q U).trans (Function.update_self e q V).symm
      · simp only [Function.update_of_ne hde, hUV d (hs hd)]
    rw [hb, hu]
  · have he : e ∉ plaquetteEdges n p := fun h => hp ((mem_plaquetteEdges n p e).mp h)
    rw [term_update_unchanged n G χ c p e he U q,
      term_update_unchanged n G χ c p e he V q, sub_self, sub_self]

/-- Fix the first block to the actual identity reference, retaining every other original edge. -/
def reference (S : Finset (Edge (Vertex n))) (U : Configuration (Vertex n) G) :
    Configuration (Vertex n) G := fun e => if e ∈ S then 1 else U e

omit [NeZero n] in
theorem reference_dependsOn (S D : Finset (Edge (Vertex n)))
    (F : Configuration (Vertex n) G → ℝ) (hF : DependsOn F (D : Set _)) :
    DependsOn (fun U => F (reference n G S U)) ((D \ S : Finset _) : Set _) := by
  intro U V hUV
  apply hF
  intro e he
  by_cases hs : e ∈ S
  · simp only [reference, if_pos hs]
  · simp only [reference, if_neg hs]
    exact hUV e (Finset.mem_sdiff.mpr ⟨he, hs⟩)

theorem plaquette_reference_dependsOn (χ : G → ℂ) (c : ℝ)
    (S : Finset (Edge (Vertex n))) (p : PlaquetteIndex n) :
    DependsOn (fun U => plaquetteTerm n G χ c (reference n G S U) p)
      ((plaquetteEdges n p \ S : Finset _) : Set _) :=
  reference_dependsOn n G S _ _ (plaquetteTerm_dependsOn n G χ c p)

/-- The actual first integration increment has at most eighteen retained dependencies. -/
theorem increment_reference_dependsOn (χ : G → ℂ) (β c : ℝ)
    (S : Finset (Edge (Vertex n))) (e : Edge (Vertex n)) (q : G) :
    DependsOn (fun U =>
      WilsonBlockIntegration.action n G χ β c (Function.update (reference n G S U) e q) -
        WilsonBlockIntegration.action n G χ β c (reference n G S U))
      (retainedStar n S e : Set _) :=
  reference_dependsOn n G S _ _ (action_increment_dependsOn n G χ β c e q)

theorem source_increment_reference_dependsOn (χ : G → ℂ) (c : ℝ)
    (f : PlaquetteIndex n → ℝ) (S : Finset (Edge (Vertex n)))
    (e : Edge (Vertex n)) (q : G) :
    DependsOn (fun U =>
      WilsonBlockIntegration.source n G χ c f (Function.update (reference n G S U) e q) -
        WilsonBlockIntegration.source n G χ c f (reference n G S U))
      (retainedStar n S e : Set _) :=
  reference_dependsOn n G S _ _ (source_increment_dependsOn n G χ c f e q)

end
end UnifiedTheory.Clay.YangMills.WilsonInducedSupport
