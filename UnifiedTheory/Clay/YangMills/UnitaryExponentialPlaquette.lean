/- Actual unitary exponential links and the classical four-link commutator
plaquette. The normalized trace defect is derived from these links, not assumed
to be a continuum quantum field. No Wilson-law covariance lower bound follows
without additional probabilistic estimates. -/
import UnifiedTheory.Clay.YangMills.UnitaryEntryEstimates
import Mathlib.Analysis.SpecialFunctions.Exponential
import Mathlib.Analysis.Calculus.Deriv.Slope
import Mathlib.Analysis.CStarAlgebra.Matrix

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 800000

namespace UnifiedTheory.Clay.YangMills.UnitaryExponentialPlaquette
noncomputable section
open Matrix Filter NormedSpace
open scoped Topology Matrix.Norms.Operator

variable {d : Type*} [Fintype d] [DecidableEq d]

/-- Half the squared Hilbert--Schmidt norm, with no matrix norm convention hidden. -/
def energy (X : Matrix d d ℂ) : ℝ := (∑ i, ∑ j, ‖X j i‖ ^ 2) / 2

theorem energy_nonneg (X : Matrix d d ℂ) : 0 ≤ energy X := by
  exact div_nonneg (Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => sq_nonneg _) (by norm_num)

theorem energy_continuous : Continuous (energy : Matrix d d ℂ → ℝ) := by
  unfold energy
  fun_prop

theorem energy_smul (r : ℝ) (X : Matrix d d ℂ) : energy (r • X) = r ^ 2 * energy X := by
  simp only [energy, Matrix.smul_apply, norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
  simp_rw [← Finset.mul_sum]
  ring

theorem unitary_defect_energy (U : Matrix.unitaryGroup d ℂ) :
    (Fintype.card d : ℝ) - (Matrix.trace (U : Matrix d d ℂ)).re =
      energy ((U : Matrix d d ℂ) - 1) := by
  have h := UnitaryHolonomyDefect.matrix_square_trace U
  rw [UnitaryEntryEstimates.square_trace] at h
  have he : (∑ i, ∑ j, ‖((1 : Matrix d d ℂ) - (U : Matrix d d ℂ)) j i‖ ^ 2) =
      ∑ i, ∑ j, ‖((U : Matrix d d ℂ) - 1) j i‖ ^ 2 := by
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    simp only [Matrix.sub_apply, norm_sub_rev]
  rw [he] at h
  unfold energy
  linarith

/-- A genuine unitary link generated by a skew-Hermitian matrix. -/
def link (X : Matrix d d ℂ) (hX : star X = -X) (t : ℝ) : Matrix.unitaryGroup d ℂ :=
  ⟨exp (t • X), exp_mem_unitary_of_mem_skewAdjoint (by
    rw [skewAdjoint.mem_iff]
    simp only [star_smul, star_trivial, hX, smul_neg])⟩

@[simp] theorem link_val (X : Matrix d d ℂ) (hX : star X = -X) (t : ℝ) :
    (link X hX t : Matrix d d ℂ) = exp (t • X) := rfl

@[simp] theorem link_zero (X : Matrix d d ℂ) (hX : star X = -X) : link X hX 0 = 1 := by
  apply Subtype.ext
  simp [link]

theorem link_tendsto_zero (X : Matrix d d ℂ) (hX : star X = -X) :
    Tendsto (fun t : ℝ => (link X hX t : Matrix d d ℂ)) (𝓝 0) (𝓝 1) := by
  have h := (hasDerivAt_exp_smul_const X (0 : ℝ)).continuousAt.tendsto
  simpa only [zero_smul, exp_zero] using h

theorem link_slope_tendsto (X : Matrix d d ℂ) (hX : star X = -X) :
    Tendsto (fun t : ℝ => t⁻¹ • ((link X hX t : Matrix d d ℂ) - 1))
      (𝓝[≠] 0) (𝓝 X) := by
  have h := (hasDerivAt_exp_smul_const X (0 : ℝ)).tendsto_slope_zero
  simpa only [zero_add, zero_smul, exp_zero, one_mul] using h

/-- Converts an actual matrix-valued leading term into the exact trace-defect limit. -/
theorem scaled_defect_tendsto {L : Filter ℝ} (U : ℝ → Matrix.unitaryGroup d ℂ)
    (s : ℝ → ℝ) (X : Matrix d d ℂ)
    (h : Tendsto (fun t => (s t)⁻¹ • ((U t : Matrix d d ℂ) - 1)) L (𝓝 X)) :
    Tendsto (fun t => ((Fintype.card d : ℝ) - (Matrix.trace (U t : Matrix d d ℂ)).re) /
      (s t) ^ 2) L (𝓝 (energy X)) := by
  have hh := energy_continuous.continuousAt.tendsto.comp h
  convert hh using 1
  ext t
  dsimp only [Function.comp_def]
  rw [energy_smul, ← unitary_defect_energy]
  simp only [inv_pow, div_eq_mul_inv]
  ring

/-- The second-order trace defect of an actual exponential link. -/
theorem link_defect_tendsto (X : Matrix d d ℂ) (hX : star X = -X) :
    Tendsto (fun t : ℝ => ((Fintype.card d : ℝ) -
      (Matrix.trace (link X hX t : Matrix d d ℂ)).re) / t ^ 2)
      (𝓝[≠] 0) (𝓝 (energy X)) :=
  scaled_defect_tendsto (link X hX) id X (link_slope_tendsto X hX)

@[simp] theorem link_neg (X : Matrix d d ℂ) (hX : star X = -X) (t : ℝ) :
    link X hX (-t) = (link X hX t)⁻¹ := by
  apply Subtype.ext
  change exp ((-t) • X) = star (exp (t • X))
  rw [star_exp, star_smul, star_trivial, hX]
  simp only [neg_smul, smul_neg]

/-- Constant-direction link transports around a positively oriented square. -/
def plaquette (X : Matrix d d ℂ) (hX : star X = -X)
    (Y : Matrix d d ℂ) (hY : star Y = -Y) (a : ℝ) : Matrix.unitaryGroup d ℂ :=
  link X hX a * link Y hY a * (link X hX a)⁻¹ * (link Y hY a)⁻¹

theorem plaquette_exp_formula (X : Matrix d d ℂ) (hX : star X = -X)
    (Y : Matrix d d ℂ) (hY : star Y = -Y) (a : ℝ) :
    (plaquette X hX Y hY a : Matrix d d ℂ) =
      exp (a • X) * exp (a • Y) * exp ((-a) • X) * exp ((-a) • Y) := by
  simp only [plaquette, ← link_neg, UnitaryGroup.mul_val, link_val]

/-- Exact algebraic cancellation of the constant and first-order contributions. -/
theorem commutator_difference (A B : Matrix.unitaryGroup d ℂ) :
    ((A * B * A⁻¹ * B⁻¹ : Matrix.unitaryGroup d ℂ) : Matrix d d ℂ) - 1 =
      (((A : Matrix d d ℂ) - 1) * ((B : Matrix d d ℂ) - 1) -
        ((B : Matrix d d ℂ) - 1) * ((A : Matrix d d ℂ) - 1)) *
        (A⁻¹ : Matrix.unitaryGroup d ℂ) * (B⁻¹ : Matrix.unitaryGroup d ℂ) := by
  have hA : (A : Matrix d d ℂ) * (A⁻¹ : Matrix.unitaryGroup d ℂ) = 1 := by
    rw [← UnitaryGroup.mul_val, mul_inv_cancel, UnitaryGroup.one_val]
  have hB : (B : Matrix d d ℂ) * (B⁻¹ : Matrix.unitaryGroup d ℂ) = 1 := by
    rw [← UnitaryGroup.mul_val, mul_inv_cancel, UnitaryGroup.one_val]
  have he : ((A : Matrix d d ℂ) - 1) * ((B : Matrix d d ℂ) - 1) -
      ((B : Matrix d d ℂ) - 1) * ((A : Matrix d d ℂ) - 1) =
      (A : Matrix d d ℂ) * (B : Matrix d d ℂ) -
        (B : Matrix d d ℂ) * (A : Matrix d d ℂ) := by noncomm_ring
  rw [he, sub_mul, sub_mul]
  simp only [UnitaryGroup.mul_val]
  rw [mul_assoc (B : Matrix d d ℂ) (A : Matrix d d ℂ), hA, mul_one, hB]

theorem scaled_commutator_difference (A B : Matrix.unitaryGroup d ℂ) (a : ℝ) :
    (a ^ 2)⁻¹ •
      (((A * B * A⁻¹ * B⁻¹ : Matrix.unitaryGroup d ℂ) : Matrix d d ℂ) - 1) =
      ((a⁻¹ • ((A : Matrix d d ℂ) - 1)) * (a⁻¹ • ((B : Matrix d d ℂ) - 1)) -
        (a⁻¹ • ((B : Matrix d d ℂ) - 1)) * (a⁻¹ • ((A : Matrix d d ℂ) - 1))) *
        (A⁻¹ : Matrix.unitaryGroup d ℂ) * (B⁻¹ : Matrix.unitaryGroup d ℂ) := by
  rw [commutator_difference]
  simp only [smul_mul_assoc, mul_smul_comm, smul_smul, ← smul_sub, ← pow_two, inv_pow]

/-- The curvature bracket is obtained from the actual four-link product. -/
theorem plaquette_slope_tendsto (X : Matrix d d ℂ) (hX : star X = -X)
    (Y : Matrix d d ℂ) (hY : star Y = -Y) :
    Tendsto (fun a : ℝ => (a ^ 2)⁻¹ • ((plaquette X hX Y hY a : Matrix d d ℂ) - 1))
      (𝓝[≠] 0) (𝓝 (X * Y - Y * X)) := by
  have hXi : Tendsto (fun a : ℝ => ((link X hX a)⁻¹ : Matrix.unitaryGroup d ℂ)
      |> fun U => (U : Matrix d d ℂ)) (𝓝[≠] 0) (𝓝 (1 : Matrix d d ℂ)) := by
    simpa only [← link_neg] using
      ((link_tendsto_zero X hX).comp (by simpa using (continuous_neg.tendsto (0 : ℝ)))).mono_left nhdsWithin_le_nhds
  have hYi : Tendsto (fun a : ℝ => ((link Y hY a)⁻¹ : Matrix.unitaryGroup d ℂ)
      |> fun U => (U : Matrix d d ℂ)) (𝓝[≠] 0) (𝓝 (1 : Matrix d d ℂ)) := by
    simpa only [← link_neg] using
      ((link_tendsto_zero Y hY).comp (by simpa using (continuous_neg.tendsto (0 : ℝ)))).mono_left nhdsWithin_le_nhds
  have h := (((link_slope_tendsto X hX).mul (link_slope_tendsto Y hY)).sub
    ((link_slope_tendsto Y hY).mul (link_slope_tendsto X hX))).mul hXi |>.mul hYi
  simpa only [mul_one, plaquette, scaled_commutator_difference] using h

/-- The Wilson trace defect has the classical fourth-order normalization for
constant noncommuting skew-Hermitian link generators. -/
theorem plaquette_defect_tendsto (X : Matrix d d ℂ) (hX : star X = -X)
    (Y : Matrix d d ℂ) (hY : star Y = -Y) :
    Tendsto (fun a : ℝ => ((Fintype.card d : ℝ) -
      (Matrix.trace (plaquette X hX Y hY a : Matrix d d ℂ)).re) / a ^ 4)
      (𝓝[≠] 0) (𝓝 (energy (X * Y - Y * X))) := by
  simpa only [← pow_mul, show 2 * 2 = 4 by decide] using
    scaled_defect_tendsto (plaquette X hX Y hY) (fun a => a ^ 2)
      (X * Y - Y * X) (plaquette_slope_tendsto X hX Y hY)

/-- A nonzero matrix has strictly positive classical quadratic energy. -/
theorem energy_pos (X : Matrix d d ℂ) (hX : X ≠ 0) : 0 < energy X := by
  obtain ⟨i, j, hij⟩ : ∃ i j, X j i ≠ 0 := by
    by_contra h
    push_neg at h
    apply hX
    ext j i
    exact h i j
  have hi : 0 < ∑ k, ‖X k i‖ ^ 2 :=
    Finset.sum_pos' (fun _ _ => sq_nonneg _) ⟨j, Finset.mem_univ _,
      sq_pos_of_pos (norm_pos_iff.mpr hij)⟩
  exact div_pos (Finset.sum_pos'
    (fun _ _ => Finset.sum_nonneg fun _ _ => sq_nonneg _) ⟨i, Finset.mem_univ _, hi⟩)
    (by norm_num)

/-- An explicit little-o remainder statement for the actual four-link trace defect.
The neighborhood depends on the fixed generators and the requested error. -/
theorem plaquette_defect_remainder (X : Matrix d d ℂ) (hX : star X = -X)
    (Y : Matrix d d ℂ) (hY : star Y = -Y) (ε : ℝ) (hε : 0 < ε) :
    ∀ᶠ a : ℝ in 𝓝[≠] 0,
      |((Fintype.card d : ℝ) - (Matrix.trace (plaquette X hX Y hY a : Matrix d d ℂ)).re) -
        a ^ 4 * energy (X * Y - Y * X)| < ε * a ^ 4 := by
  have hlim := plaquette_defect_tendsto X hX Y hY
  have hn := (hlim.sub (tendsto_const_nhds (x := energy (X * Y - Y * X)))).norm
  have he : ∀ᶠ a : ℝ in 𝓝[≠] 0,
      |((Fintype.card d : ℝ) - (Matrix.trace (plaquette X hX Y hY a : Matrix d d ℂ)).re) /
        a ^ 4 - energy (X * Y - Y * X)| < ε := by
    have hh := hn.eventually (eventually_lt_nhds (by simpa using hε))
    simpa only [Real.norm_eq_abs] using hh
  filter_upwards [he, self_mem_nhdsWithin] with a ha ha0
  have ha0 : a ≠ 0 := by simpa using ha0
  have ha4 : 0 < a ^ 4 := by positivity
  have hid : ((Fintype.card d : ℝ) -
      (Matrix.trace (plaquette X hX Y hY a : Matrix d d ℂ)).re) -
        a ^ 4 * energy (X * Y - Y * X) =
      (((Fintype.card d : ℝ) - (Matrix.trace (plaquette X hX Y hY a : Matrix d d ℂ)).re) /
        a ^ 4 - energy (X * Y - Y * X)) * a ^ 4 := by
    field_simp
  rw [hid, abs_mul, abs_of_pos ha4]
  exact mul_lt_mul_of_pos_right ha ha4

/-- A positive deterministic reference along this classical family. This is not
a lower bound on a Wilson-law variance or on a smeared reflected covariance. -/
theorem plaquette_defect_lower (X : Matrix d d ℂ) (hX : star X = -X)
    (Y : Matrix d d ℂ) (hY : star Y = -Y) (hXY : X * Y - Y * X ≠ 0) :
    ∀ᶠ a : ℝ in 𝓝[≠] 0,
      (energy (X * Y - Y * X) / 2) * a ^ 4 ≤
        (Fintype.card d : ℝ) - (Matrix.trace (plaquette X hX Y hY a : Matrix d d ℂ)).re := by
  have hp := energy_pos (X * Y - Y * X) hXY
  have he := (plaquette_defect_tendsto X hX Y hY).eventually
    (eventually_gt_nhds (show energy (X * Y - Y * X) / 2 < energy (X * Y - Y * X) by linarith))
  filter_upwards [he, self_mem_nhdsWithin] with a ha ha0
  have ha0 : a ≠ 0 := by simpa using ha0
  have ha4 : 0 < a ^ 4 := by positivity
  exact ((lt_div_iff₀ ha4).mp ha).le

end
end UnifiedTheory.Clay.YangMills.UnitaryExponentialPlaquette
