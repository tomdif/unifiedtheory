/- Quantitative mixed interactions created by actual compact Gibbs integration.
The mixed free-energy difference is controlled by two genuine source interpolations,
not by a supplied estimate on the induced potential. The bounds alone are not
weak-coupling contraction estimates. -/
import UnifiedTheory.Clay.YangMills.CompactGibbsOscillation
import UnifiedTheory.Clay.YangMills.FiniteFactorElimination

set_option autoImplicit false
set_option relaxedAutoImplicit false
namespace UnifiedTheory.Clay.YangMills.GibbsMixedInteraction
noncomputable section
open MeasureTheory

variable {X : Type*} [TopologicalSpace X] [CompactSpace X]
  [MeasurableSpace X] [BorelSpace X] (μ : Measure X) [IsProbabilityMeasure μ]

/-- The literal negative logarithm of the normalized-reference partition. -/
def freeEnergy (A : X → ℝ) : ℝ := -Real.log (∫ x, Real.exp (-A x) ∂μ)

/-- The mixed part of the integrated potential generated by two additive sources. -/
def mixed (A F G : X → ℝ) : ℝ :=
  freeEnergy μ (fun x => A x - F x - G x) - freeEnergy μ (fun x => A x - F x) -
    freeEnergy μ (fun x => A x - G x) + freeEnergy μ A

/-- The derivative is the difference of expectations under the two actual tilted laws. -/
theorem log_difference_hasDerivAt (A F G : X → ℝ)
    (hA : Continuous A) (hF : Continuous F) (hG : Continuous G) (t : ℝ) :
    HasDerivAt (fun s => Real.log (CompactGibbsSource.partition μ (fun x => A x - G x) F s) -
      Real.log (CompactGibbsSource.partition μ A F s))
      (CompactGibbsSource.expectation μ (fun x => A x - G x) F F t -
        CompactGibbsSource.expectation μ A F F t) t :=
  (CompactGibbsSource.log_partition_hasDerivAt μ _ F (hA.sub hG) hF t).sub
    (CompactGibbsSource.log_partition_hasDerivAt μ A F hA hF t)

/-- A pair interaction is bounded by the product of source oscillations, with factor one quarter. -/
theorem mixed_bound (A F G : X → ℝ) (hA : Continuous A) (hF : Continuous F)
    (hG : Continuous G) (f₀ f₁ g₀ g₁ : ℝ) (hf : f₀ ≤ f₁) (hg : g₀ ≤ g₁)
    (hFb : ∀ x, F x ∈ Set.Icc f₀ f₁) (hGb : ∀ x, G x ∈ Set.Icc g₀ g₁) :
    |mixed μ A F G| ≤ (f₁ - f₀) * (g₁ - g₀) / 4 := by
  have hb (t : ℝ) :
      |CompactGibbsSource.expectation μ (fun x => A x - G x) F F t -
        CompactGibbsSource.expectation μ A F F t| ≤ (f₁ - f₀) * (g₁ - g₀) / 4 := by
    apply CompactGibbsOscillation.action_expectation_difference μ
      (CompactGibbsSource.action A F t)
      (CompactGibbsSource.action (fun x => A x - G x) F t) F
      (CompactGibbsSource.action_continuous A F hA hF t)
      (CompactGibbsSource.action_continuous _ F (hA.sub hG) hF t) hF
      g₀ g₁ f₀ f₁ hg hf _ hFb
    intro x
    convert hGb x using 1
    dsimp only [CompactGibbsSource.action]
    ring
  have h := norm_image_sub_le_of_norm_deriv_le_segment_01'
    (fun t _ => (log_difference_hasDerivAt μ A F G hA hF hG t).hasDerivWithinAt)
    (fun t _ => hb t)
  have he : ((fun s => Real.log (CompactGibbsSource.partition μ (fun x => A x - G x) F s) -
      Real.log (CompactGibbsSource.partition μ A F s)) 1 -
      (fun s => Real.log (CompactGibbsSource.partition μ (fun x => A x - G x) F s) -
        Real.log (CompactGibbsSource.partition μ A F s)) 0) = -mixed μ A F G := by
    simp only [CompactGibbsSource.partition, CompactGibbsSource.weight, CompactGibbsSource.action,
      one_mul, zero_mul, sub_zero, mixed, freeEnergy]
    have hfg (x : X) : A x - G x - F x = A x - F x - G x := by ring
    simp_rw [hfg]
    ring
  rw [he, Real.norm_eq_abs, abs_neg] at h
  exact h

/-- Actual integration is one-Lipschitz in a uniform action perturbation. -/
theorem freeEnergy_difference_bound (A B : X → ℝ) (hA : Continuous A) (hB : Continuous B)
    (d : ℝ) (hAB : ∀ x, |A x - B x| ≤ d) :
    |freeEnergy μ A - freeEnergy μ B| ≤ d := by
  have hZ (F : X → ℝ) (hF : Continuous F) :=
    CompactGibbsContinuity.partition_positive μ F hF
  have hi (F : X → ℝ) (hF : Continuous F) :
      Integrable (fun x => Real.exp (-F x)) μ :=
    (Real.continuous_exp.comp hF.neg).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have hcomp (F G : X → ℝ) (hF : Continuous F) (hG : Continuous G)
      (hFG : ∀ x, G x - F x ≤ d) :
      Real.log (∫ x, Real.exp (-F x) ∂μ) ≤
        d + Real.log (∫ x, Real.exp (-G x) ∂μ) := by
    have hh := integral_mono (hi F hF) ((hi G hG).const_mul (Real.exp d)) (fun x => by
      rw [← Real.exp_add]
      apply Real.exp_le_exp.mpr
      have hx := hFG x
      linarith)
    rw [integral_const_mul] at hh
    have hl := Real.log_le_log (hZ F hF) hh
    rw [Real.log_mul (Real.exp_ne_zero _) (hZ G hG).ne', Real.log_exp] at hl
    exact hl
  have hl := hcomp A B hA hB (fun x => by
    have hx := (abs_le.mp (hAB x)).1
    linarith)
  have hu := hcomp B A hB hA (fun x => (abs_le.mp (hAB x)).2)
  unfold freeEnergy
  exact abs_le.mpr ⟨by linarith, by linarith⟩

/-- A general boundary rectangle separates the original mixed interaction from
new coupling created by the actual common conditional integration. -/
theorem rectangle_bound (A₀₀ A₁₀ A₀₁ A₁₁ : X → ℝ)
    (h₀₀ : Continuous A₀₀) (h₁₀ : Continuous A₁₀) (h₀₁ : Continuous A₀₁)
    (h₁₁ : Continuous A₁₁) (f₀ f₁ g₀ g₁ d : ℝ)
    (hf : f₀ ≤ f₁) (hg : g₀ ≤ g₁)
    (hF : ∀ x, A₀₀ x - A₁₀ x ∈ Set.Icc f₀ f₁)
    (hG : ∀ x, A₀₀ x - A₀₁ x ∈ Set.Icc g₀ g₁)
    (hD : ∀ x, |A₁₁ x - A₁₀ x - A₀₁ x + A₀₀ x| ≤ d) :
    |freeEnergy μ A₁₁ - freeEnergy μ A₁₀ - freeEnergy μ A₀₁ + freeEnergy μ A₀₀| ≤
      d + (f₁ - f₀) * (g₁ - g₀) / 4 := by
  let F := fun x => A₀₀ x - A₁₀ x
  let G := fun x => A₀₀ x - A₀₁ x
  let B := fun x => A₀₀ x - F x - G x
  have hm := mixed_bound μ A₀₀ F G h₀₀ (h₀₀.sub h₁₀) (h₀₀.sub h₀₁)
    f₀ f₁ g₀ g₁ hf hg hF hG
  have hd := freeEnergy_difference_bound μ A₁₁ B h₁₁
    ((h₀₀.sub (h₀₀.sub h₁₀)).sub (h₀₀.sub h₀₁)) d (fun x => by
      convert hD x using 1
      dsimp only [B, F, G]
      congr 1
      ring)
  have he : freeEnergy μ A₁₁ - freeEnergy μ A₁₀ - freeEnergy μ A₀₁ + freeEnergy μ A₀₀ =
      (freeEnergy μ A₁₁ - freeEnergy μ B) + mixed μ A₀₀ F G := by
    have hF' : (fun x => A₀₀ x - F x) = A₁₀ := by funext x; dsimp [F]; ring
    have hG' : (fun x => A₀₀ x - G x) = A₀₁ := by funext x; dsimp [G]; ring
    unfold mixed
    rw [hF', hG']
    change _ = (freeEnergy μ A₁₁ - freeEnergy μ B) +
      (freeEnergy μ B - freeEnergy μ A₁₀ - freeEnergy μ A₀₁ + freeEnergy μ A₀₀)
    ring
  rw [he]
  exact (abs_add_le _ _).trans (add_le_add hd hm)

/-- The rule applies to the literal generated factor in the repeatable local-action
construction. Its inputs bound only explicit pre-integration action increments. -/
theorem nextFactor_rectangle_bound {I P : Type*} [Finite I] [Fintype P] [DecidableEq I]
    [SecondCountableTopology X] (Φ : P → (I → X) → ℝ) (hΦ : ∀ p, Continuous (Φ p))
    (T : Finset I) (x₀ : X) (e : T) (U₀₀ U₁₀ U₀₁ U₁₁ : I → X)
    (f₀ f₁ g₀ g₁ d : ℝ) (hf : f₀ ≤ f₁) (hg : g₀ ≤ g₁)
    (hF : ∀ q, FiniteFactorElimination.increment Φ T x₀ e (U₀₀, q) -
      FiniteFactorElimination.increment Φ T x₀ e (U₁₀, q) ∈ Set.Icc f₀ f₁)
    (hG : ∀ q, FiniteFactorElimination.increment Φ T x₀ e (U₀₀, q) -
      FiniteFactorElimination.increment Φ T x₀ e (U₀₁, q) ∈ Set.Icc g₀ g₁)
    (hD : ∀ q, |FiniteFactorElimination.increment Φ T x₀ e (U₁₁, q) -
      FiniteFactorElimination.increment Φ T x₀ e (U₁₀, q) -
      FiniteFactorElimination.increment Φ T x₀ e (U₀₁, q) +
      FiniteFactorElimination.increment Φ T x₀ e (U₀₀, q)| ≤ d) :
    |FiniteFactorElimination.nextFactor μ Φ T x₀ (.inr e) U₁₁ -
      FiniteFactorElimination.nextFactor μ Φ T x₀ (.inr e) U₁₀ -
      FiniteFactorElimination.nextFactor μ Φ T x₀ (.inr e) U₀₁ +
      FiniteFactorElimination.nextFactor μ Φ T x₀ (.inr e) U₀₀| ≤
        d + (f₁ - f₀) * (g₁ - g₀) / 4 := by
  have hc (U : I → X) : Continuous (fun q => FiniteFactorElimination.increment Φ T x₀ e (U, q)) :=
    (FiniteFactorElimination.increment_continuous Φ hΦ T x₀ e).comp
      (continuous_const.prodMk continuous_id)
  exact rectangle_bound μ _ _ _ _ (hc U₀₀) (hc U₁₀) (hc U₀₁) (hc U₁₁)
    f₀ f₁ g₀ g₁ d hf hg hF hG hD

end
end UnifiedTheory.Clay.YangMills.GibbsMixedInteraction
